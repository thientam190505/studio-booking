# PostgreSQL connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="change-me-in-production-please-use-long-random-string"

# (Tuỳ chọn) SMTP để gửi email xác nhận thật. Bỏ trống => chỉ log ra console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
